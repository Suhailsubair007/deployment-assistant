# Copy this file to .env and adjust. Only OPENAI_API_KEY is a secret; .env is not committed.

# Port the web app listens on (127.0.0.1 only).
PORT=3000

# Which kubeconfig context to use. Leave empty to use the current context.
# Local cluster: kind-deploy-assistant. EKS: the context created by "aws eks update-kubeconfig".
KUBE_CONTEXT=kind-deploy-assistant

# Thresholds, timeouts and environment names.
CONFIG_PATH=config/app.config.yaml

# SQLite file for the deployment history.
DB_PATH=data/assistant.db

# Registry in front of image names. Leave it empty: for kind there is none (images are
# loaded into the cluster), and for EKS the assistant works it out from the cluster's name.
# Set it only to use another registry than that one.
IMAGE_REGISTRY=

# AWS profile used when a service is built from a project folder on EKS: for creating its
# image repository (Terraform) and for uploading the image. Not used on kind.
# It is kept apart from the profile the cluster login uses: the kubeconfig keeps its own.
# Leave empty to use the AWS login of the terminal the assistant was started in.
AWS_BUILD_PROFILE=

# Bucket that holds the Terraform state of those image repositories. Optional: left empty,
# it is the bucket the bootstrap stack made, deployment-assistant-tfstate-<account>-<region>.
TF_STATE_BUCKET=

# The "owner" tag on what Terraform creates for a service. Optional: left empty, it is
# deployment-assistant.
TF_OWNER=

# OpenAI API key. Optional: leave it empty and the assistant reads messages with its
# built-in rules. With a key, OpenAI reads them (model and timeout: config/app.config.yaml).
# This is a secret. Put the real key in .env only, never in this file.
OPENAI_API_KEY=
