{
  "name": "deployment-assistant",
  "version": "1.0.0",
  "description": "Chat assistant that deploys an app to Kubernetes and reports its health, CPU and memory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import ./scripts/register-alias.mjs --env-file-if-exists=.env src/server.ts",
    "test": "node --import ./scripts/register-alias.mjs --test \"tests/**/*.test.ts\" \"frontend/tests/**/*.test.ts\"",
    "smoke": "node --import ./scripts/register-alias.mjs scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace frontend",
    "dev:web": "npm run dev --workspace frontend"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "express": "^5.3.0",
    "openai": "^7.32.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "frontend"
  ]
}
